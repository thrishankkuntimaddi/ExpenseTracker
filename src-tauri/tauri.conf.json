{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ExpenseTracker",
  "mainBinaryName": "ExpenseTracker",
  "version": "../package.json",
  "identifier": "com.thrishank.expensetracker",
  "build": {
    "frontendDist": "../dist-native",
    "beforeBuildCommand": "npm run build:native",
    "devUrl": "http://localhost:5173/ExpenseTracker/",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Expense Tracker",
        "width": 1280,
        "height": 840,
        "minWidth": 380,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#E4E5EA"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Personal finance, synced across devices",
    "copyright": "\u00a9 Thrishank Kuntimaddi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4QTA3QkEzMDBENDUwRkUKUldUK1VOUUFvM3VnR0JGNms5L1NrV2hDV3RZdDNnT3oweURCV1FBd0UyWURTOG1iTW9rZVQ1OVkK",
      "endpoints": [
        "https://github.com/thrishankkuntimaddi/ExpenseTracker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
