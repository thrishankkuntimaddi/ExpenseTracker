rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── ExpenseTracker (project expensetracker-385b0 — this app only) ──
    // Each user can reach only their own user doc and everything beneath it.
    // Anything not matched below is denied.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Money: a real number below ₹1 lakh crore in magnitude. Negatives are
    // allowed because existing data uses them for corrections/refunds.
    function validMoney(v) {
      return (v is int || v is float) && v > -1000000000000 && v < 1000000000000;
    }

    // Shape check for transactions and income entries
    function validEntry(d) {
      return validMoney(d.amount)
        && d.date is string && d.date.size() <= 40
        && d.name is string && d.name.size() > 0 && d.name.size() <= 500
        && (!('wasteAmount' in d) || validMoney(d.wasteAmount));
    }

    // ─── Shared trips (several accounts on one trip) ──────────────────
    // shared_trips/{tripId}: only its creator changes the trip itself.
    // Anyone signed in may read a trip by its id — the id is long and random
    // and travels only inside the invite link — and may join it once, while
    // it is open, by adding just themselves.
    // Rows: each person writes their own rows and their wallet partner's
    // ("pays together"); the creator writes any row. Closed trips are locked.
    // Settlements: either side of a payment marks it, or the creator.
    match /shared_trips/{tripId} {
      function signedIn() { return request.auth != null; }
      function trip() { return get(/databases/$(database)/documents/shared_trips/$(tripId)).data; }
      function isTripOwner(t) { return signedIn() && t.ownerUid == request.auth.uid; }
      function isTripMember(t) { return signedIn() && request.auth.uid in t.memberUids; }
      function unitOf(t, memberId) { return t.memberUnit.get(memberId, 'm:' + memberId); }
      function myUnit(t) { return unitOf(t, t.uidMember[request.auth.uid]); }

      function validTrip(d) {
        return d.name is string && d.name.size() > 0 && d.name.size() <= 200
          && d.ownerUid is string
          && d.members is list && d.members.size() <= 50
          && d.memberUids is list && d.memberUids.size() <= 50
          && d.uidMember is map && d.people is map && d.memberUnit is map
          && d.status in ['open', 'closed', 'archived'];
      }

      // Joining: only themselves added, nothing else touched, nobody removed.
      // The people already on the trip (names, wallets) can't be changed by a
      // joiner — at most one new person is appended: { id, name }, them.
      // An account the creator took off can't come back by the link, and the
      // person it was can't be claimed by anyone else.
      function isJoin() {
        let before = resource.data;
        let after = request.resource.data;
        let n = before.members.size();
        return before.status == 'open'
          && !(request.auth.uid in before.memberUids)
          && !(request.auth.uid in before.get('removedUids', []))
          && !(after.uidMember[request.auth.uid] in before.get('retiredMembers', []))
          && after.members[0:n] == before.members
          && (after.members.size() == n
              || (after.members[n].keys().hasOnly(['id', 'name'])
                  && after.members[n].id == after.uidMember[request.auth.uid]
                  && after.members[n].name is string && after.members[n].name.size() <= 100))
          && after.people[request.auth.uid].keys().hasOnly(['name', 'photo'])
          && after.diff(before).affectedKeys().hasOnly(['members', 'memberUids', 'uidMember', 'people', 'updatedAt'])
          && after.memberUids.toSet().difference(before.memberUids.toSet()).hasOnly([request.auth.uid])
          && before.memberUids.toSet().difference(after.memberUids.toSet()).size() == 0
          && after.uidMember.diff(before.uidMember).affectedKeys().hasOnly([request.auth.uid])
          && after.people.diff(before.people).affectedKeys().hasOnly([request.auth.uid])
          && !(after.uidMember[request.auth.uid] in before.uidMember.values())
          && after.members.size() >= before.members.size()
          && after.members.size() <= before.members.size() + 1;
      }

      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids
        && validTrip(request.resource.data);
      allow update: if signedIn() && validTrip(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (isTripOwner(resource.data) || isJoin());
      allow delete: if isTripOwner(resource.data);

      // A row says who wrote it (`by`) — always the account writing it
      function validRow(e) {
        return e.keys().hasOnly(['title', 'amount', 'paidBy', 'splitAmong', 'date', 'category', 'by', 'updatedAt'])
          && e.by == request.auth.uid
          && e.paidBy is string && e.paidBy.size() <= 64
          && e.title is string && e.title.size() <= 200
          && (e.amount == null || validMoney(e.amount))
          && (!('splitAmong' in e) || (e.splitAmong is list && e.splitAmong.size() <= 50));
      }
      function canWriteRow(t, e) {
        return isTripOwner(t)
          || (isTripMember(t) && t.status == 'open' && unitOf(t, e.paidBy) == myUnit(t));
      }
      match /expenses/{expenseId} {
        allow read: if isTripMember(trip());
        allow create: if validRow(request.resource.data) && canWriteRow(trip(), request.resource.data);
        allow update: if validRow(request.resource.data)
          && canWriteRow(trip(), resource.data) && canWriteRow(trip(), request.resource.data);
        allow delete: if canWriteRow(trip(), resource.data);
      }

      function canSettle(t, s) {
        return isTripOwner(t)
          || (isTripMember(t) && t.status == 'open' && myUnit(t) in [s.fromUnit, s.toUnit]);
      }
      match /settlements/{settlementId} {
        allow read: if isTripMember(trip());
        // A payment is positive and marked by the account that marks it
        allow create: if validMoney(request.resource.data.amount) && request.resource.data.amount > 0
          && request.resource.data.by == request.auth.uid
          && request.resource.data.fromUnit is string && request.resource.data.fromUnit.size() <= 80
          && request.resource.data.toUnit is string && request.resource.data.toUnit.size() <= 80
          && canSettle(trip(), request.resource.data);
        allow delete: if canSettle(trip(), resource.data);
      }
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /transactions/{txnId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validEntry(request.resource.data);
      }

      match /income/{incId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validEntry(request.resource.data);
      }

      // Recurring rules: must carry a name and sane amount
      match /recurring/{ruleId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validMoney(request.resource.data.amount)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
          && request.resource.data.kind in ['expense', 'savings', 'income'];
      }

      // Trips (group expense splitting): bounded name and member/expense/settlement lists
      match /trips/{tripId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
          && request.resource.data.members is list && request.resource.data.members.size() <= 50
          && request.resource.data.expenses is list && request.resource.data.expenses.size() <= 1000
          && (!('settlements' in request.resource.data)
              || (request.resource.data.settlements is list && request.resource.data.settlements.size() <= 1000));
      }

      // Security alerts: the app writes new ones (unsent) and may only mark
      // them answered afterwards; whether it was emailed is the notifier's
      // business (it uses the admin SDK) — so an alert can't be re-sent or
      // hidden from email by editing it
      match /security_events/{eventId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.notified == false
          && request.resource.data.type is string && request.resource.data.type.size() <= 40;
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy', 'dismissedAt', 'dismissedBy']);
      }

      // Owner-only for every other subcollection (external_transactions,
      // recently_deleted, devices, …). Rules are OR'd, so the validated
      // collections above are excluded here.
      match /{collection}/{rest=**} {
        allow read, write: if isOwner(userId)
          && !(collection in ['transactions', 'income', 'recurring', 'trips', 'security_events']);
      }
    }
  }
}
