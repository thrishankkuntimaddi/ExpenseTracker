rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️  SHARED PROJECT (nistha-passi-core): this ruleset covers EVERY app in
    //     the project. Never `firebase deploy --only firestore:rules` from one
    //     app's repo without merging the live console rules first — paste
    //     changes into Firebase Console → Firestore → Rules instead.

    // ─── ExpenseTracker (+ ClearMyMind, which also lives under users/) ──
    // Strict user-scoped rules: each user can only access their own
    // user doc and everything beneath it.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Money: a real number below ₹1 lakh crore in magnitude. Negatives are
    // allowed because existing data uses them for corrections/refunds.
    function validMoney(v) {
      return (v is int || v is float) && v > -1000000000000 && v < 1000000000000;
    }

    // Shape check for transactions and income entries
    function validEntry(d) {
      return validMoney(d.amount)
        && d.date is string && d.date.size() <= 40
        && d.name is string && d.name.size() > 0 && d.name.size() <= 500
        && (!('wasteAmount' in d) || validMoney(d.wasteAmount));
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /transactions/{txnId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validEntry(request.resource.data);
      }

      match /income/{incId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validEntry(request.resource.data);
      }

      // Recurring rules: must carry a name and sane amount
      match /recurring/{ruleId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validMoney(request.resource.data.amount)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
          && request.resource.data.kind in ['expense', 'savings', 'income'];
      }

      // Trips (group expense splitting): bounded name and member/expense/settlement lists
      match /trips/{tripId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
          && request.resource.data.members is list && request.resource.data.members.size() <= 50
          && request.resource.data.expenses is list && request.resource.data.expenses.size() <= 1000
          && (!('settlements' in request.resource.data)
              || (request.resource.data.settlements is list && request.resource.data.settlements.size() <= 1000));
      }

      // Owner-only for every other subcollection: ExpenseTracker's
      // external_transactions / recently_deleted / devices, and ClearMyMind's
      // memory / memoryTrash / data. (Rules are OR'd, so the validated
      // collections above are excluded here.)
      match /{collection}/{rest=**} {
        allow read, write: if isOwner(userId)
          && !(collection in ['transactions', 'income', 'recurring', 'trips']);
      }
    }

    // ─── Nistha Meditation App ───────────────────────────────────────
    // Legacy v1 sessions: one top-level doc per session, owned via userId.
    match /sessions/{sessionId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Meditation v2: presets, history, settings and the cross-device focus
    // lock — each user can only reach their own data.
    match /meditation_users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // ─── Other Apps (shared Firebase project) ───────────────────────
    // Catch-all for the other apps in this project (Chttrix, etc.).
    // Firestore rules are OR'd — a broad match here would also grant access to
    // every collection above — so all of them are explicitly excluded.
    //
    // ⚠️  ACTION REQUIRED: Replace this catch-all with app-specific rules
    //     for each other app as you build/maintain them.
    match /{collection}/{rest=**} {
      allow read, write: if request.auth != null
        && !(collection in ['users', 'meditation_users', 'sessions']);
    }
  }
}
