# ── Google Sheets Proxy — Environment Variables ───────────────────────────────
#
# Copy this file to server/.env and fill in the values.
# NEVER commit server/.env to git.
#
# ─── How to get a service account key ────────────────────────────────────────
# 1. Go to console.cloud.google.com → create / select a project
# 2. Enable the "Google Sheets API" in APIs & Services → Library
# 3. Go to IAM & Admin → Service Accounts → Create Service Account
# 4. Skip the "Grant this service account access to project" step — it needs
#    NO project IAM role. Access is granted per sheet in step 7 only.
# 5. Click the service account → Keys tab → Add Key → JSON
# 6. Download the JSON file
# 7. Share your Google Sheet with the service account email  (viewer for pull, editor for push)
# 8. Minify the JSON to one line and paste it below
#
# TIP: node -e "console.log(JSON.stringify(require('./sa-key.json')))"
# ─────────────────────────────────────────────────────────────────────────────

# Paste the ENTIRE contents of the service account JSON key here (minified to one line)
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Port the proxy will listen on (default 3001)
PORT=3001

# Frontend origin for CORS — update if your dev URL differs
FRONTEND_URL=http://localhost:5173

# Interface to bind to. Keep 127.0.0.1 unless you are deliberately hosting the proxy.
HOST=127.0.0.1

# Firebase project whose ID tokens are accepted (every /api call requires one)
FIREBASE_PROJECT_ID=nistha-passi-core

# Optional: comma-separated Firebase UIDs allowed to use this proxy.
# Strongly recommended if the proxy is reachable by anyone but you, because the
# service account can read every sheet that has been shared with it.
ALLOWED_UIDS=
