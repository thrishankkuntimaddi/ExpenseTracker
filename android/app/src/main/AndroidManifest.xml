<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share a payment message or a screenshot / receipt photo to the app -->
            <intent-filter android:label="Add to Expense Tracker">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="Add to Expense Tracker">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- Widget taps: expensetracker://add/expense, …/page/bills -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="expensetracker" />
            </intent-filter>
        </activity>

        <!-- Quick entry from a widget: a small card over the home screen, not the app -->
        <activity
            android:name=".QuickEntryActivity"
            android:exported="false"
            android:theme="@style/QuickEntryTheme"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleInstance"
            android:windowSoftInputMode="stateAlwaysVisible|adjustNothing" />

        <!-- Home-screen widgets -->
        <receiver android:name=".QuickAddWidget" android:exported="false" android:label="@string/widget_quick_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quick_info" />
        </receiver>
        <receiver android:name=".SummaryWidget" android:exported="false" android:label="@string/widget_summary_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_summary_info" />
        </receiver>
        <receiver android:name=".BillsWidget" android:exported="false" android:label="@string/widget_bills_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_bills_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Debugging receivers that libraries add (guarded by the system-only
             DUMP permission): AndroidX WorkManager diagnostics and the adb
             trigger of the startup-profile installer. Not used by the app;
             startup profiles still install the normal way. -->
        <receiver android:name="androidx.work.impl.diagnostics.DiagnosticsReceiver" tools:node="remove" />
        <receiver android:name="androidx.profileinstaller.ProfileInstallReceiver" tools:node="remove" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reminders are inexact unless the user turns on "On time" in Reminders;
         Android 12+ then asks them to allow "Alarms & reminders". -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- AndroidX WorkManager declares this for foreground workers; the app
         never runs a foreground service, so it isn't requested. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
</manifest>
