{
  "name": "expensetracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "test": "TZ=Asia/Kolkata vitest run",
    "build:native": "CAPACITOR=1 vite build",
    "cap:sync": "npm run build:native && npx cap sync",
    "android": "npm run cap:sync && npx cap open android",
    "ios": "npm run cap:sync && npx cap open ios",
    "android:apk": "npm run cap:sync && npm run assets:generate -- --android && cd android && ./gradlew assembleDebug",
    "assets:generate": "npx --yes @capacitor/assets generate --iconBackgroundColor '#0A0D14' --iconBackgroundColorDark '#0A0D14' --splashBackgroundColor '#0A0D14' --splashBackgroundColorDark '#0A0D14'"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "firebase": "^12.12.0",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.4",
    "vitest": "^5.0.3"
  }
}
