# ── Firebase web config (required) ───────────────────────────────────────────
# Firebase Console → Project settings → General → Your apps → SDK setup and configuration.
# These are public identifiers, not secrets, but they are kept out of git and the
# API key MUST be restricted by HTTP referrer in Google Cloud — see SECURITY.md.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── Optional ─────────────────────────────────────────────────────────────────
# reCAPTCHA v3 site key — turns on Firebase App Check (recommended for a public deployment)
VITE_APPCHECK_SITE_KEY=

# Google sign-in in the DESKTOP app (Google Cloud Console → APIs & Services →
# Credentials → OAuth client ID → "Desktop app"). Google treats desktop client
# secrets as non-confidential. Leave empty to hide Google sign-in on desktop.
VITE_GOOGLE_DESKTOP_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=

# Web push (website reminders while the page is closed, security alerts):
# Firebase Console → Project settings → Cloud Messaging → Web Push certificates → key pair.
VITE_FIREBASE_VAPID_KEY=

# Google Drive backup on the WEBSITE (the Android and desktop apps don't need it):
# an OAuth client ID of type "Web application" whose Authorized JavaScript origins
# include the site (e.g. https://<you>.github.io). Without it, Google-account users
# can still back up through a sign-in popup.
VITE_GOOGLE_WEB_CLIENT_ID=
